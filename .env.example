# Auth Supabase (cloud). Les comptes restent ici. Google et le lien magique ne changent pas.
# Ces deux valeurs sont aussi des arguments de build Docker : elles sont figées dans le JS du navigateur.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Postgres du jeu. Hors Docker, pointe vers le port publié sur la machine.
# Dans Compose, le service app écrase cette valeur par postgresql://fantasy:…@db:5432/fantasy
DATABASE_URL=postgresql://fantasy:change-me@127.0.0.1:5432/fantasy

# Mot de passe du service db. Même secret que dans DATABASE_URL.
POSTGRES_PASSWORD=change-me

# Cron (ingestion OpenF1, calcul des scores). Vide = les crons répondent 401.
CRON_SECRET=your-random-secret

# Adresse du site pour Caddy. Omettre cette ligne sert l'app en HTTP sur le port 80.
# Le jour de la bascule DNS : SITE_ADDRESS=ligue.example.com
# SITE_ADDRESS=:80

# Sur localhost, remplace Google et le lien magique par cinq joueurs de test.
# Les deux lignes vont ensemble. Ne pas les activer sur le VPS.
# LOCAL_AUTH_BYPASS=1
# NEXT_PUBLIC_LOCAL_AUTH_BYPASS=1

# Ids Supabase autorisés à écrire le calendrier et les résultats, séparés par des virgules.
# Un owner de ligue n'a pas ce droit.
ADMIN_USER_IDS=

# OpenF1 (pas de clé requise, API publique)
# OPENF1_BASE_URL=https://api.openf1.org/v1
